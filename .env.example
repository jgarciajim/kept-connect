# Copy this file to .env.local and fill in real values.
# .env.local is gitignored — NEVER commit real keys.

# --- Supabase (https://supabase.com/dashboard → Project Settings → API) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- Sign-in providers (Supabase Auth) ---
# Comma-separated social buttons to show on /sign-in and /sign-up. List a provider
# ONLY after it is enabled in Supabase → Authentication → Sign In / Providers.
# Email + password and email codes are always on. Example: google,apple,facebook
NEXT_PUBLIC_AUTH_PROVIDERS=

# --- Stripe (optional — when unset, payments use the mock adapter) ---
# See src/lib/payments/README.md for the activation steps.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# --- Mapbox (optional — address autocomplete/geocoding) ---
# When unset, address fields degrade to plain text + "use current location".
# Token: https://account.mapbox.com → Access tokens (a public pk.* token is fine).
# Server-side only (proxied via /api/geo/*). Restart the dev server after setting.
MAPBOX_TOKEN=
GEO_PROVIDER=mapbox

# --- Resend transactional email (optional — when unset, email is logged, not sent) ---
# API key: https://resend.com → API Keys (one key per app; revoke independently).
# RESEND_FROM must be an address at a domain VERIFIED in that Resend account
# (https://resend.com/domains); unset falls back to the owner-only test sender.
# Production: mail.guildry.app is the verified sending subdomain.
RESEND_API_KEY=
RESEND_FROM=Guildry <notify@mail.guildry.app>

# --- Vetting (optional — when unset, verification is mock + manual admin approval) ---
# CHECKR_API_KEY=            # background checks (src/lib/vetting)

# --- Hosted setup (not env vars) ---
# Scheduler: run supabase/scripts/hosted-cron.sql once in the Supabase SQL Editor
#   to schedule dispatch_tick() + recompute_eta_calibration() via pg_cron.
# Real Stripe webhook reconciliation will also need the Supabase service-role key.

# --- DB -> app hook (Pro job-alert emails) ---
# Shared secret the database sends with each alert. MUST equal the Supabase Vault
# secret named notify_hook_secret (select vault.create_secret('<value>', 'notify_hook_secret');).
NOTIFY_HOOK_SECRET=
