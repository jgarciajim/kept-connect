# Copy this file to .env.local and fill in real values.
# .env.local is gitignored — NEVER commit real keys.

# --- Clerk (https://dashboard.clerk.com → API keys) ---
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# --- Supabase (https://supabase.com/dashboard → Project Settings → API) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- Stripe (optional — when unset, payments use the mock adapter) ---
# See src/lib/payments/README.md for the activation steps.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# --- Mapbox (optional — address autocomplete/geocoding) ---
# When unset, address fields degrade to plain text + "use current location".
# Token: https://account.mapbox.com → Access tokens (a public pk.* token is fine).
# Server-side only (proxied via /api/geo/*). Restart the dev server after setting.
MAPBOX_TOKEN=
GEO_PROVIDER=mapbox

# --- Vetting (optional — when unset, verification is mock + manual admin approval) ---
# CHECKR_API_KEY=            # background checks (src/lib/vetting)

# --- Hosted setup (not env vars) ---
# Scheduler: run supabase/scripts/hosted-cron.sql once in the Supabase SQL Editor
#   to schedule dispatch_tick() + recompute_eta_calibration() via pg_cron.
# Real Stripe webhook reconciliation will also need the Supabase service-role key.
